# Required: choose ONE supported LLM provider for local extraction.
# Copy to .env; never commit .env or paste a real key into issues.
OPENAI_API_KEY=__SET_IN_PRIVATE_ENV__

# Optional: use any OpenAI-compatible model endpoint (Ollama, LM Studio, vLLM, llama.cpp, etc.).
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=gpt-oss:20b
# OPENAI_FAST_MODEL=gpt-oss:20b
# OPENAI_TEXT_MODEL=gpt-oss:20b

# Optional: change published local port or bind interface.
# SUPERMEMORY_PORT=6767
# BIND_ADDRESS=127.0.0.1

# Reproducible build pins. Update only through the documented upgrade process.
SUPERMEMORY_CLI_VERSION=4.25.4
SUPERMEMORY_SERVER_VERSION=0.0.3

# Optional remote embedding provider. Omit all of these to use the server's local default.
# SUPERMEMORY_EMBEDDING_PROVIDER=local
# SUPERMEMORY_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5
# SUPERMEMORY_EMBEDDING_DIMENSIONS=768
# SUPERMEMORY_EMBEDDING_BASE_URL=

# Optional ingestion capacity controls.
# SUPERMEMORY_EMBEDDING_RAM_LIMIT=1gb
# SUPERMEMORY_INGEST_CONCURRENCY=2
